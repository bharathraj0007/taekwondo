# Database Configurations
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/taekwondo_db?retryWrites=true&w=majority"

# Cloudinary Storage Configurations
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# JSON Web Token Secret (MUST be at least 32 characters long)
JWT_SECRET="e9f4c3a2b10d5e8f7a6b4c2d0e8f6a4b2c0d8e6f4a2b0c8d6e4f2a0b8c6d4e2f"

# Node Environment
NODE_ENV="development"
PORT="3000"

# SMTP Email Configurations (Standard SMTP Fallback)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM='"CombatFlow Taekwondo" <no-reply@combatflow.com>'
ALERT_EMAIL_TO="admin-alerts@yourdomain.com"

# 📧 Google Mail Configurations (Dedicated for sending Player OTPs)
GOOGLE_SMTP_USER="your-gmail@gmail.com"
GOOGLE_SMTP_PASS="your-gmail-16-character-app-password"
GOOGLE_SMTP_FROM='"CombatFlow Taekwondo" <your-gmail@gmail.com>'

# 📧 Resend SMTP Configurations (Dedicated for Admin Health Alerts)
RESEND_SMTP_HOST="smtp.resend.com"
RESEND_SMTP_PORT="465"
RESEND_SMTP_USER="resend"
RESEND_SMTP_PASS="re_your_resend_api_key"
RESEND_SMTP_FROM='"CombatFlow Health Guard" <onboarding@resend.dev>'

# Health Monitoring Engine Configuration
HEALTH_CHECK_CRON="0 */3 * * *" # Cron expression for scheduled system scans (Defaults to ~8 times daily)
